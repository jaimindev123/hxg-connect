# Copy to .env. In production EVERY secret below must be set explicitly —
# the API refuses to boot with dev defaults when NODE_ENV=production.
NODE_ENV=development
PORT=4000

# Owner connection: migrations only. Runtime never uses it.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/hxg_connect
# Super Admin console role — no access to client lead data.
DATABASE_PLATFORM_URL=postgres://hxg_platform:hxg_platform_dev@localhost:5432/hxg_connect
# Client CRM role — every row filtered by row-level security.
DATABASE_APP_URL=postgres://hxg_app:hxg_app_dev@localhost:5432/hxg_connect

# Different secrets per realm. Generate each with: openssl rand -base64 48
PLATFORM_JWT_SECRET=
TENANT_JWT_SECRET=
# Signs expiring links to selfies and other stored files.
FILE_SIGNING_SECRET=

# Encrypts integration keys (Razorpay, Exotel, WhatsApp, SMTP) in the database.
# BACK THIS UP. If it's lost or changed, every saved key must be re-entered.
ENCRYPTION_KEY=

# Optional. Leave empty until you own a domain: everyone signs in at the server
# address and types their workspace. You can also set it later in the console
# (Settings > Domain), which overrides this value.
BASE_DOMAIN=
DEFAULT_COUNTRY_CODE=91

# First super admin, created by the first migration run only.
SUPER_ADMIN_EMAIL=founder@hxgconnect.com
SUPER_ADMIN_PASSWORD=change-me-now-please

# Where uploaded files live (local disk until S3/R2 is wired in).
STORAGE_DIR=./storage
# Requests per minute per IP across the API.
RATE_LIMIT_PER_MIN=600

# Billing runs invoices on the 1st and dunning hourly. Set to off on all but
# one instance if you run several API replicas.
BILLING_SCHEDULER=on

# Property portal emails (optional). Clients forward portal enquiry emails to
# <key>@INBOUND_EMAIL_DOMAIN; your inbound mail service posts them to
# https://hxgconnect.com/api/webhooks/inbound-email?secret=INBOUND_EMAIL_SECRET
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=               # openssl rand -hex 24  (hex: it goes in a URL)
