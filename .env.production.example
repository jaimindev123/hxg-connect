# Copy to .env on the server. Generate every secret with:  openssl rand -base64 48
# Keep a copy of this file in your password manager. Losing ENCRYPTION_KEY means
# every client re-enters their integration keys.

BASE_DOMAIN=hxgconnect.com          # clients at name.hxgconnect.com, console at admin.hxgconnect.com
ACME_EMAIL=you@hxgconnect.com       # Let's Encrypt expiry notices

POSTGRES_PASSWORD=                  # database superuser (migrations only)
DATABASE_APP_URL=postgres://hxg_app:CHANGE_ME_16+_CHARS@db:5432/hxg_connect
DATABASE_PLATFORM_URL=postgres://hxg_platform:CHANGE_ME_16+_CHARS@db:5432/hxg_connect

PLATFORM_JWT_SECRET=
TENANT_JWT_SECRET=
FILE_SIGNING_SECRET=
ENCRYPTION_KEY=

SUPER_ADMIN_EMAIL=you@hxgconnect.com
SUPER_ADMIN_PASSWORD=               # 12+ characters; used only on the very first start

RATE_LIMIT_PER_MIN=600
BILLING_SCHEDULER=on

# Property portal emails (optional). Clients forward portal enquiry emails to
# <key>@INBOUND_EMAIL_DOMAIN; your inbound mail service posts them to
# https://hxgconnect.com/api/webhooks/inbound-email?secret=INBOUND_EMAIL_SECRET
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=               # openssl rand -hex 24  (hex: it goes in a URL)
